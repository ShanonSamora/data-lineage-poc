{
  "name": "IngestCustomerData",
  "properties": {
    "activities": [
      {
        "name": "CopyFromBlobToSQL",
        "type": "Copy",
        "inputs": [
          {
            "referenceName": "BlobCustomersCSV",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "SqlRawCustomers",
            "type": "DatasetReference"
          }
        ],
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource"
          },
          "sink": {
            "type": "AzureSqlSink",
            "writeBehavior": "upsert"
          }
        }
      },
      {
        "name": "CopyTransactionsToStaging",
        "type": "Copy",
        "inputs": [
          {
            "referenceName": "BlobTransactionsParquet",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "SqlStagingTransactions",
            "type": "DatasetReference"
          }
        ],
        "typeProperties": {
          "source": {
            "type": "ParquetSource"
          },
          "sink": {
            "type": "AzureSqlSink"
          }
        }
      },
      {
        "name": "RunTransformPipeline",
        "type": "ExecutePipeline",
        "typeProperties": {
          "pipeline": {
            "referenceName": "TransformCustomerMetrics",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true
        }
      }
    ]
  }
}
