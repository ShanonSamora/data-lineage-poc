# Environment configuration
# Copy this file to .env and fill in your values

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lineage-poc-2024

# OpenAI API (for LLM fallback)
# GPT-4.1-mini: best cost/quality for structured code analysis
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini

# Git repository to scan (local path or clone URL)
REPO_PATH=./sample_repo

# Server
HOST=0.0.0.0
PORT=8000
