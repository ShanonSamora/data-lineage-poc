# Environment configuration
# Copy this file to .env and fill in your values

# OpenAI API (for LLM fallback on stored procedures, dynamic SQL, Python)
# gpt-4.1-mini is the default — best cost/quality for structured code analysis
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini

# Git repository to scan (local path or clone URL)
REPO_PATH=./sample_repo

# Server
HOST=0.0.0.0
PORT=8000
